# The API reads these from the environment (no .env loader); defaults shown.
CORS_ORIGINS=http://localhost:3000
CHURN_N_TRIALS=40
CHURN_TIMEOUT_SECONDS=900
# Optional: CHURN_APP_DIR=data/app  CHURN_MLFLOW_DIR=mlruns  (empty CHURN_MLFLOW_DIR turns MLflow logging off)

# The frontend reads this at build time; put it in frontend/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
